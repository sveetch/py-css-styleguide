{
    "name": "PyCssStyleguide frontend",
    "version": "1.3.0",
    "description": "The project frontend.",
    "author": "David Thenon <sveetch@gmail.com>",
    "private": true,
    "scripts": {
        "css": "sass --load-path=./node_modules --silence-deprecation=color-functions --silence-deprecation=global-builtin --silence-deprecation=import --silence-deprecation=if-function ../tests/data_fixtures/sass/scss/:../tests/data_fixtures/sass/css/",
        "css-prod": "sass --style compressed --load-path=./node_modules ../tests/data_fixtures/sass/scss/:../tests/data_fixtures/sass/css/",
        "watch-css": "nodemon --watch ../tests/data_fixtures/sass/scss/ --ext scss --exec \"npm run-script css\""
    },
    "dependencies": {
        "sass-embedded": "1.95.1"
    },
    "devDependencies": {
        "nodemon": "^3.1.9",
        "npm-run-all": "^4.1.5"
    },
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.0.0"
    },
    "browserslist": [
        ">= 0.5%",
        "last 2 major versions",
        "not dead",
        "Chrome >= 60",
        "Firefox >= 60",
        "Firefox ESR",
        "iOS >= 12",
        "Safari >= 12",
        "not Explorer <= 11"
    ]
}
